# Copy to .env (same directory as docker-compose.yml) and fill in real values.
# Never commit the real .env file.

# Shared bearer token for the acikmedya-webhook service (see acikmedya-webhook/README.md).
ACIKMEDYA_WEBHOOK_TOKEN=

# Gmail OAuth2 credentials for the AcikIstihbarat.API mailing engine (see
# ProjectImplementationDocs/Implementation-Plan-Mailing-Engine.md, Phase 1).
MAIL_GMAIL_CLIENT_ID=
MAIL_GMAIL_CLIENT_SECRET=
MAIL_GMAIL_REFRESH_TOKEN=
MAIL_GMAIL_SENDER_ADDRESS=

